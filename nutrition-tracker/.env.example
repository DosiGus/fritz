APP_ENV=development
APP_NAME=telegram-nutrition-tracker
LOG_LEVEL=INFO
BASE_URL=http://localhost:8000
ADMIN_TOKEN=

TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# Pick exactly one update mechanism: set BOT_WEBHOOK_MODE=true and stop the `bot` polling service, or keep it false and rely on polling.
BOT_WEBHOOK_MODE=false

DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/nutrition
REDIS_URL=redis://redis:6379/0

OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:7b

OPENAI_API_KEY=
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-transcribe
OPENAI_TRANSCRIPTION_TIMEOUT=60
FOOD_INTENT_V2_ENABLED=true
OPENAI_FOOD_INTENT_MODEL=gpt-4o-mini
OPENAI_FOOD_INTENT_TIMEOUT=30

OPEN_FOOD_FACTS_USER_AGENT=NutritionTracker/0.1 (contact@example.com)

USDA_API_KEY=

SENTRY_DSN=

VOICE_PROCESSING_ENABLED=true
MAX_VOICE_SECONDS=120

VOICE_TMP_DIR=/tmp/voice
